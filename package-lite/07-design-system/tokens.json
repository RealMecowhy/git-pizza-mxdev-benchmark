{
  "$description": "Git Pizza MxDev design tokens v1.0 (2026-11-05). Format follows the W3C Design Tokens draft: each token has $value and $type. Source: Stitch tailwind configs (all 20 screens share one palette), the Stitch UI kit and the Developer Handover doc; conflicts resolved in tokens.md. Dark theme only.",
  "color": {
    "surface": {
      "lowest":   { "$value": "#0e0e0e", "$type": "color", "$description": "Terminal windows, code blocks, map well, inset areas" },
      "base":     { "$value": "#131313", "$type": "color", "$description": "Page background" },
      "low":      { "$value": "#1b1b1c", "$type": "color", "$description": "Cards, sidebar, side panels" },
      "container":{ "$value": "#202020", "$type": "color", "$description": "Header, footer, table header" },
      "high":     { "$value": "#2a2a2a", "$type": "color", "$description": "Elevated panes, hover on cards, selected nav item" },
      "highest":  { "$value": "#353535", "$type": "color", "$description": "Inputs, chips, segmented controls" },
      "bright":   { "$value": "#393939", "$type": "color", "$description": "Hover on inputs and chips" },
      "glass":    { "$value": "rgba(26, 26, 26, 0.8)", "$type": "color", "$description": "Glass panels; always with blur.glass and border.default" }
    },
    "overlay": {
      "scrim":    { "$value": "rgba(0, 0, 0, 0.6)", "$type": "color", "$description": "Backdrop behind modals and drawers" },
      "grid":     { "$value": "rgba(255, 196, 133, 0.03)", "$type": "color", "$description": "32px background grid lines (home, confirmation)" }
    },
    "text": {
      "primary":   { "$value": "#e5e2e1", "$type": "color", "$description": "Main text" },
      "secondary": { "$value": "#dac2ad", "$type": "color", "$description": "Secondary text, descriptions" },
      "muted":     { "$value": "#a28d79", "$type": "color", "$description": "Captions, metadata, placeholders" },
      "disabled":  { "$value": "#6e6e6e", "$type": "color", "$description": "Disabled text, code comments" },
      "inverse":   { "$value": "#131313", "$type": "color", "$description": "Text on light fills" }
    },
    "primary": {
      "default":  { "$value": "#ff9d00", "$type": "color", "$description": "Pizza Orange. Brand color, primary CTA fill, active progress" },
      "hover":    { "$value": "#ffb869", "$type": "color", "$description": "Primary CTA hover" },
      "pressed":  { "$value": "#e08a00", "$type": "color", "$description": "Primary CTA pressed (added, not in Stitch)" },
      "light":    { "$value": "#ffc485", "$type": "color", "$description": "Accent text, links, active nav, active tab underline, icons on dark" },
      "on":       { "$value": "#2c1700", "$type": "color", "$description": "Text and icons on primary.default and primary.light fills" },
      "subtle":   { "$value": "rgba(255, 157, 0, 0.12)", "$type": "color", "$description": "Selected option background" },
      "border":   { "$value": "rgba(255, 157, 0, 0.2)", "$type": "color", "$description": "Accent borders" }
    },
    "success": {
      "default":  { "$value": "#00ff41", "$type": "color", "$description": "Terminal Green. Success fills, live indicators, DEPLOYED" },
      "text":     { "$value": "#72ff70", "$type": "color", "$description": "Success text and log lines on dark" },
      "on":       { "$value": "#003907", "$type": "color", "$description": "Text on success.default" },
      "subtle":   { "$value": "rgba(0, 255, 65, 0.12)", "$type": "color", "$description": "Success badge background" }
    },
    "warning": {
      "default":  { "$value": "#f1fa8c", "$type": "color", "$description": "Warnings, STAGED" },
      "on":       { "$value": "#1f2000", "$type": "color", "$description": "Text on warning.default" },
      "subtle":   { "$value": "rgba(241, 250, 140, 0.12)", "$type": "color", "$description": "Warning badge background" }
    },
    "error": {
      "default":  { "$value": "#ff5555", "$type": "color", "$description": "Errors, destructive actions, ROLLED_BACK, PAYMENT_FAILED" },
      "text":     { "$value": "#ffb4ab", "$type": "color", "$description": "Error text on dark, field error messages" },
      "on":       { "$value": "#131313", "$type": "color", "$description": "Text on error.default" },
      "container":{ "$value": "#93000a", "$type": "color", "$description": "Strong danger fills (not used on Lite screens)" },
      "onContainer": { "$value": "#ffdad6", "$type": "color", "$description": "Text on error.container" },
      "subtle":   { "$value": "rgba(255, 85, 85, 0.12)", "$type": "color", "$description": "Error badge background" }
    },
    "info": {
      "default":  { "$value": "#38bdf8", "$type": "color", "$description": "Accent Cyan. Info, dispatch and delivery states, links in logs" },
      "on":       { "$value": "#082f49", "$type": "color", "$description": "Text on info.default" },
      "subtle":   { "$value": "rgba(56, 189, 248, 0.12)", "$type": "color", "$description": "Info badge background" }
    },
    "tertiary": {
      "default":  { "$value": "#dec4ff", "$type": "color", "$description": "QA stage, syntax keywords" },
      "container":{ "$value": "#c8a2ff", "$type": "color", "$description": "QA badge fill" },
      "on":       { "$value": "#290055", "$type": "color", "$description": "Text on tertiary fills" },
      "subtle":   { "$value": "rgba(222, 196, 255, 0.12)", "$type": "color", "$description": "QA badge background" }
    },
    "border": {
      "default":  { "$value": "#333333", "$type": "color", "$description": "Panels, cards, inputs" },
      "subtle":   { "$value": "#2a2a2a", "$type": "color", "$description": "Dividers inside panels" },
      "strong":   { "$value": "#544433", "$type": "color", "$description": "Header and footer separators" },
      "accent":   { "$value": "rgba(255, 157, 0, 0.2)", "$type": "color", "$description": "Highlighted panels" },
      "focus":    { "$value": "#ffc485", "$type": "color", "$description": "Keyboard focus ring" }
    },
    "status": {
      "staged":   { "$value": "#f1fa8c", "$type": "color", "$description": "PAYMENT_PENDING (STAGED)" },
      "failed":   { "$value": "#ff5555", "$type": "color", "$description": "PAYMENT_FAILED, CANCELLED (ROLLED_BACK)" },
      "queued":   { "$value": "#a28d79", "$type": "color", "$description": "QUEUED" },
      "baking":   { "$value": "#ff9d00", "$type": "color", "$description": "BAKING" },
      "qa":       { "$value": "#dec4ff", "$type": "color", "$description": "QA_CHECK" },
      "dispatch": { "$value": "#38bdf8", "$type": "color", "$description": "READY_FOR_DISPATCH, READY_FOR_PICKUP, OUT_FOR_DELIVERY" },
      "deployed": { "$value": "#00ff41", "$type": "color", "$description": "DELIVERED (DEPLOYED), PICKED_UP (PULLED)" }
    },
    "syntax": {
      "keyword":    { "$value": "#dec4ff", "$type": "color" },
      "string":     { "$value": "#72ff70", "$type": "color" },
      "number":     { "$value": "#ffb869", "$type": "color" },
      "function":   { "$value": "#ffc485", "$type": "color" },
      "property":   { "$value": "#e5e2e1", "$type": "color" },
      "boolean":    { "$value": "#38bdf8", "$type": "color" },
      "comment":    { "$value": "#6e6e6e", "$type": "color", "$description": "Always italic" },
      "punctuation":{ "$value": "#a28d79", "$type": "color" },
      "error":      { "$value": "#ffb4ab", "$type": "color" }
    },
    "log": {
      "info":    { "$value": "#38bdf8", "$type": "color", "$description": "[INFO] tag" },
      "success": { "$value": "#72ff70", "$type": "color", "$description": "[SUCCESS] tag" },
      "warn":    { "$value": "#f1fa8c", "$type": "color", "$description": "[WARN] tag" },
      "error":   { "$value": "#ff5555", "$type": "color", "$description": "[ERROR] tag" },
      "debug":   { "$value": "#a28d79", "$type": "color", "$description": "[DEBUG] tag (internal lines only)" },
      "timestamp": { "$value": "#6e6e6e", "$type": "color" }
    },
    "terminal": {
      "dotRed":    { "$value": "#ef4444", "$type": "color", "$description": "Window chrome dot" },
      "dotYellow": { "$value": "#eab308", "$type": "color", "$description": "Window chrome dot" },
      "dotGreen":  { "$value": "#22c55e", "$type": "color", "$description": "Window chrome dot" },
      "cursor":    { "$value": "#72ff70", "$type": "color", "$description": "Blinking block cursor (amber variant uses primary.light)" }
    },
    "brand": {
      "slice":            { "$value": "#ff9d00", "$type": "color", "$description": "Pixel Slice logo: slice body and wordmark underscore (= primary.default)" },
      "crust":            { "$value": "#ffc485", "$type": "color", "$description": "Pixel Slice logo: crust (= primary.light)" },
      "ink":              { "$value": "#131313", "$type": "color", "$description": "Pixel Slice logo: pepperoni cut-outs (= surface.base)" },
      "wordmarkOnDark":   { "$value": "#f5f5f5", "$type": "color", "$description": "Wordmark git and pizza on dark backgrounds" },
      "wordmarkOnLight":  { "$value": "#131313", "$type": "color", "$description": "Wordmark git and pizza on light backgrounds" },
      "mxdevOnDark":      { "$value": "#00ff41", "$type": "color", "$description": "Wordmark mxdev on dark backgrounds (= success.default)" },
      "mxdevOnLight":     { "$value": "#00a82b", "$type": "color", "$description": "Wordmark mxdev on light backgrounds" },
      "logoBackground":   { "$value": "#131313", "$type": "color", "$description": "Tile of the app icon, stacked logo on dark square and OG image" }
    }
  },
  "font": {
    "family": {
      "mono": { "$value": "'JetBrains Mono', 'Fira Code', 'SF Mono', Menlo, Consolas, monospace", "$type": "fontFamily", "$description": "All UI text, headings, labels, code, numbers" },
      "body": { "$value": "'Geist', 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif", "$type": "fontFamily", "$description": "Long paragraphs only (descriptions, hero text)" }
    },
    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    }
  },
  "typography": {
    "display":    { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontSize": "48px", "lineHeight": 1.1, "fontWeight": 700, "letterSpacing": "-0.02em" }, "phone": { "fontSize": "32px", "lineHeight": 1.15 }, "$description": "Hero headline" },
    "h1":         { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontSize": "32px", "lineHeight": 1.2, "fontWeight": 600, "letterSpacing": "-0.01em" }, "phone": { "fontSize": "24px" }, "$description": "Page title" },
    "h2":         { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontSize": "24px", "lineHeight": 1.25, "fontWeight": 600, "letterSpacing": "0" }, "phone": { "fontSize": "20px" }, "$description": "Section title" },
    "h3":         { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontSize": "18px", "lineHeight": 1.3, "fontWeight": 600, "letterSpacing": "0" }, "phone": { "fontSize": "16px" }, "$description": "Card title, module name" },
    "bodyLong":   { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontSize": "16px", "lineHeight": 1.6, "fontWeight": 400, "letterSpacing": "0" }, "phone": { "fontSize": "15px" }, "$description": "Descriptions and paragraphs (Geist)" },
    "body":       { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontSize": "14px", "lineHeight": 1.5, "fontWeight": 400, "letterSpacing": "0" }, "$description": "Default UI text" },
    "bodySmall":  { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontSize": "13px", "lineHeight": 1.5, "fontWeight": 400, "letterSpacing": "0" }, "$description": "Secondary UI text, table cells" },
    "code":       { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontSize": "14px", "lineHeight": 1.4, "fontWeight": 500, "letterSpacing": "0" }, "$description": "Code blocks" },
    "codeSmall":  { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontSize": "12px", "lineHeight": 1.5, "fontWeight": 500, "letterSpacing": "0" }, "$description": "Log lines, terminal output" },
    "label":      { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontSize": "12px", "lineHeight": 1.0, "fontWeight": 700, "letterSpacing": "0.05em", "textTransform": "uppercase" }, "$description": "Section labels, buttons, status badges" },
    "micro":      { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontSize": "11px", "lineHeight": 1.2, "fontWeight": 500, "letterSpacing": "0.02em" }, "$description": "Chips, version tags, footnotes. Never for sentences." },
    "priceLarge": { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontSize": "32px", "lineHeight": 1.1, "fontWeight": 700, "letterSpacing": "-0.01em" }, "phone": { "fontSize": "24px" }, "$description": "Order total, ETA countdown" }
  },
  "space": {
    "0":  { "$value": "0px",  "$type": "dimension" },
    "1":  { "$value": "4px",  "$type": "dimension" },
    "2":  { "$value": "8px",  "$type": "dimension" },
    "3":  { "$value": "12px", "$type": "dimension" },
    "4":  { "$value": "16px", "$type": "dimension" },
    "5":  { "$value": "20px", "$type": "dimension" },
    "6":  { "$value": "24px", "$type": "dimension" },
    "8":  { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" }
  },
  "layout": {
    "gutter":         { "$value": "16px",   "$type": "dimension" },
    "marginPhone":    { "$value": "16px",   "$type": "dimension" },
    "marginTablet":   { "$value": "32px",   "$type": "dimension" },
    "marginDesktop":  { "$value": "64px",   "$type": "dimension" },
    "containerMax":   { "$value": "1280px", "$type": "dimension" },
    "sidebarWidth":   { "$value": "256px",  "$type": "dimension", "$description": "Project Explorer sidebar (desktop)" },
    "sidePanelWidth": { "$value": "320px",  "$type": "dimension", "$description": "Terminal Debugger cart panel (desktop)" },
    "drawerWidth":    { "$value": "480px",  "$type": "dimension", "$description": "Cart drawer (desktop/tablet)" },
    "headerHeight":   { "$value": "72px",   "$type": "dimension", "phone": "56px" },
    "bottomNavHeight":{ "$value": "64px",   "$type": "dimension", "$description": "Phone bottom tabs, plus safe-area inset" },
    "demoBannerHeight": { "$value": "32px", "$type": "dimension" },
    "touchTargetMin": { "$value": "44px",   "$type": "dimension" },
    "modalMaxWidth":  { "$value": "640px",  "$type": "dimension" }
  },
  "radius": {
    "none":    { "$value": "0px",    "$type": "dimension" },
    "sm":      { "$value": "2px",    "$type": "dimension", "$description": "Default: buttons, inputs, chips, badges" },
    "md":      { "$value": "4px",    "$type": "dimension", "$description": "Cards, panels, terminal windows" },
    "lg":      { "$value": "8px",    "$type": "dimension", "$description": "Modals, drawers, bottom sheets" },
    "xl":      { "$value": "12px",   "$type": "dimension", "$description": "Large media (product image frame)" },
    "full":    { "$value": "9999px", "$type": "dimension", "$description": "Status dots, count bubbles, map markers" }
  },
  "borderWidth": {
    "default": { "$value": "1px", "$type": "dimension" },
    "strong":  { "$value": "2px", "$type": "dimension", "$description": "Active tab underline, selected option, focus ring" }
  },
  "shadow": {
    "elevation1":  { "$value": "0 1px 8px rgba(0, 0, 0, 0.3)",   "$type": "shadow", "$description": "Cards on hover, header" },
    "elevationTop":{ "$value": "0 -2px 12px rgba(0, 0, 0, 0.4)", "$type": "shadow", "$description": "Phone bottom bar, sticky CTA" },
    "modal":       { "$value": "0 16px 48px rgba(0, 0, 0, 0.6)", "$type": "shadow", "$description": "Modals and drawers (added, not in Stitch)" }
  },
  "glow": {
    "primarySmall":  { "$value": "0 0 12px rgba(255, 196, 133, 0.3)", "$type": "shadow", "$description": "Hover/active on primary elements" },
    "primaryMedium": { "$value": "0 0 24px rgba(255, 157, 0, 0.45)",  "$type": "shadow", "$description": "Primary CTA" },
    "primaryLarge":  { "$value": "0 0 32px rgba(255, 157, 0, 0.65)",  "$type": "shadow", "$description": "Hero CTA, confirmation icon" },
    "success":       { "$value": "0 0 8px rgba(114, 255, 112, 0.8)",  "$type": "shadow", "$description": "Live dot" },
    "statusQueued":  { "$value": "0 0 12px rgba(162, 141, 121, 0.2)", "$type": "shadow" },
    "statusBaking":  { "$value": "0 0 12px rgba(255, 196, 133, 0.2)", "$type": "shadow" },
    "statusDispatch":{ "$value": "0 0 12px rgba(56, 189, 248, 0.2)",  "$type": "shadow", "$description": "Added" },
    "statusDeployed":{ "$value": "0 0 12px rgba(114, 255, 112, 0.2)", "$type": "shadow" },
    "statusFailed":  { "$value": "0 0 12px rgba(255, 85, 85, 0.25)",  "$type": "shadow", "$description": "Added" },
    "textTerminal":  { "$value": "0 0 8px rgba(114, 255, 112, 0.4)",  "$type": "shadow", "$description": "text-shadow on green terminal text" }
  },
  "blur": {
    "glass": { "$value": "12px", "$type": "dimension", "$description": "Backdrop blur for glass panels and modal backdrops" }
  },
  "opacity": {
    "disabled": { "$value": 0.38, "$type": "number" },
    "hover":    { "$value": 0.08, "$type": "number", "$description": "White overlay on hover for surfaces" }
  },
  "breakpoint": {
    "phone":   { "$value": "0px",    "$type": "dimension", "$description": "0-767px; design reference 390px" },
    "tablet":  { "$value": "768px",  "$type": "dimension", "$description": "768-1199px; design reference 834px" },
    "desktop": { "$value": "1200px", "$type": "dimension", "$description": ">= 1200px; design reference 1280-1440px" },
    "wide":    { "$value": "1440px", "$type": "dimension", "$description": ">= 1440px; content stays within layout.containerMax plus sidebar" }
  },
  "zIndex": {
    "base":        { "$value": 0,   "$type": "number" },
    "raised":      { "$value": 10,  "$type": "number" },
    "sidebar":     { "$value": 90,  "$type": "number" },
    "stickyHeader":{ "$value": 100, "$type": "number" },
    "bottomNav":   { "$value": 100, "$type": "number" },
    "demoBanner":  { "$value": 110, "$type": "number" },
    "dropdown":    { "$value": 200, "$type": "number" },
    "drawer":      { "$value": 300, "$type": "number" },
    "scrim":       { "$value": 400, "$type": "number" },
    "modal":       { "$value": 410, "$type": "number" },
    "toast":       { "$value": 500, "$type": "number" },
    "tooltip":     { "$value": 600, "$type": "number" }
  },
  "motion": {
    "duration": {
      "instant":  { "$value": "0ms",    "$type": "duration" },
      "fast":     { "$value": "120ms",  "$type": "duration", "$description": "Hover, press" },
      "base":     { "$value": "200ms",  "$type": "duration", "$description": "Toggles, tabs, chips" },
      "slow":     { "$value": "320ms",  "$type": "duration", "$description": "Drawers, modals, bottom sheets" },
      "progress": { "$value": "1000ms", "$type": "duration", "$description": "Progress bars and map marker interpolation between updates" },
      "blink":    { "$value": "1000ms", "$type": "duration", "$description": "Terminal cursor blink, step-end" },
      "pulse":    { "$value": "2000ms", "$type": "duration", "$description": "LIVE dot pulse" }
    },
    "easing": {
      "standard":   { "$value": [0.2, 0, 0, 1], "$type": "cubicBezier" },
      "emphasized": { "$value": [0.3, 0, 0, 1], "$type": "cubicBezier" },
      "linear":     { "$value": [0, 0, 1, 1],   "$type": "cubicBezier", "$description": "Progress and route movement" }
    }
  },
  "icon": {
    "family": { "$value": "Material Symbols Outlined", "$type": "fontFamily", "$description": "FILL 0, wght 400, GRAD 0, opsz 24" },
    "size": {
      "sm": { "$value": "16px", "$type": "dimension" },
      "md": { "$value": "20px", "$type": "dimension" },
      "lg": { "$value": "24px", "$type": "dimension", "$description": "Default" },
      "xl": { "$value": "32px", "$type": "dimension" }
    }
  }
}
